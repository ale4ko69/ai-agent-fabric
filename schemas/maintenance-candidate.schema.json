{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project-local maintenance candidate preview",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "paths", "commands", "delivery", "evidence"],
  "properties": {
    "task_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "commands": {"type": "array", "items": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}},
    "delivery": {"type": "array", "uniqueItems": true, "items": {"enum": ["commit", "push", "release"]}},
    "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "edit": {
      "type": "object", "additionalProperties": false, "required": ["path", "before_sha256", "content"],
      "properties": {"path": {"type": "string", "minLength": 1}, "before_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "content": {"type": "string"}}
    },
    "evaluations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["nonempty-utf8", "no-conflict-markers", "json-object"]}}
  }
}
