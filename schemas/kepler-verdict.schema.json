{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Agent Fabric Kepler verdict",
  "type": "object",
  "required": ["schema_version", "spec_revision", "plan_revision", "verdict", "reviewed_artifacts", "artifact_digests", "out_of_scope_disposition"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "spec_revision": {"type": "integer", "minimum": 1},
    "plan_revision": {"type": "integer", "minimum": 1},
    "verdict": {"enum": ["pending", "advice", "challenge", "block"]},
    "reviewed_artifacts": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["spec.md", "research.md", "plan.md"]}
    },
    "artifact_digests": {
      "type": "object",
      "required": ["spec.md", "research.md", "plan.md"],
      "additionalProperties": false,
      "properties": {
        "spec.md": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "research.md": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "plan.md": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "out_of_scope_disposition": {"enum": ["none", "backlog", "amendment-request"]}
  }
}
