{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Agent Fabric user installation manifest",
  "type": "object",
  "required": ["schema_version", "fabric_home", "current_release", "releases"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "fabric_home": {"type": "string", "minLength": 1},
    "current_release": {"type": "string", "minLength": 1},
    "releases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["version", "path", "manifest_sha256"],
        "additionalProperties": false,
        "properties": {
          "version": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  }
}
