{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Agent Fabric canonical profiles",
  "type": "object",
  "required": ["schema_version", "profiles"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "profiles": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "required": ["id", "persona", "purpose", "activation", "capabilities", "model_policy"],
        "additionalProperties": false,
        "properties": {
          "id": {"enum": ["orchestrator", "explore", "plan", "opponent", "dev", "review", "validation"]},
          "persona": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "activation": {"enum": ["always", "project-capability"]},
          "capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "model_policy": {
            "type": "object",
            "required": ["capability_floor", "cost_policy"],
            "additionalProperties": false,
            "properties": {
              "capability_floor": {"enum": ["economy", "standard", "deep"]},
              "cost_policy": {"enum": ["minimize", "balanced", "quality-first"]}
            }
          }
        }
      }
    }
  }
}
