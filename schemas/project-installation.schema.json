{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Agent Fabric project-only runtime ownership",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "mode", "project_root", "fabric_home", "fabric_release",
    "client", "client_activation", "source_sha256", "preview_sha256",
    "files", "directories", "transient_paths"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "mode": {"const": "project-runtime"},
    "project_root": {"type": "string", "minLength": 1},
    "fabric_home": {"type": "string", "minLength": 1},
    "fabric_release": {
      "type": "string",
      "pattern": "^(?!(?:[cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][mM][1-9]|[lL][pP][tT][1-9])(?:\\.|$))[0-9A-Za-z](?:[0-9A-Za-z._+-]*[0-9A-Za-z_+-])?(?![\\s\\S])"
    },
    "client": {"const": "codex"},
    "client_activation": {"const": "none"},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "preview_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "files": {"$ref": "#/$defs/paths"},
    "directories": {"$ref": "#/$defs/paths"},
    "transient_paths": {"$ref": "#/$defs/paths"}
  },
  "$defs": {
    "paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "description": "Normalized project-relative state paths: no empty/dot components, control or Windows-special characters, trailing dots/spaces, or case-insensitive reserved device names.",
        "pattern": "^\\.agent-fabric(?:/(?!(?:[cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][mM][1-9]|[lL][pP][tT][1-9])(?:\\.|/|$))[^/\\\\:<>\"|?*\\u0000-\\u001f]*[^/\\\\:<>\"|?* .\\u0000-\\u001f])*(?![\\s\\S])"
      }
    }
  }
}
